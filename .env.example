# Copy this file to .env.local for local secrets. Do not commit .env.local.
# Discord settings are optional. The site can run without a bot token.
PORT=3000
TIER_SECRET=change-this-secret
DISCORD_BOT_TOKEN=
# Channel sources:
# - Legacy DSM channels: DISCORD_SOURCE_CHANNEL_ID / DISCORD_SOURCE_CHANNEL_IDS
# - Per-board channels: DISCORD_SOURCE_CHANNEL_ID_DSM / DISCORD_SOURCE_CHANNEL_IDS_DSM
#                     : DISCORD_SOURCE_CHANNEL_ID_PP57 / DISCORD_SOURCE_CHANNEL_IDS_PP57
DISCORD_SOURCE_CHANNEL_ID=
DISCORD_SOURCE_CHANNEL_IDS=
DISCORD_SOURCE_CHANNEL_ID_DSM=
DISCORD_SOURCE_CHANNEL_IDS_DSM=
DISCORD_SOURCE_CHANNEL_ID_PP57=
DISCORD_SOURCE_CHANNEL_IDS_PP57=
DISCORD_SOURCE_GUILD_IDS=
DISCORD_SOURCE_BOT_ID=
DISCORD_SOURCE_BOT_IDS=
DISCORD_RESULT_PREFIX=
DISCORD_ACCEPT_BOT_MESSAGES=true
DISCORD_ACCEPT_HUMAN_MESSAGES=false
TIERS_CORS_ORIGINS=
