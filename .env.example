# Copy this file to .env.local for local secrets. Do not commit .env.local.
# Discord settings are optional. The site can run without a bot token.
PORT=3000
TIER_SECRET=change-this-secret
DISCORD_BOT_TOKEN=
# Prefer the plural lists below. The single-ID values still work as a fallback.
DISCORD_SOURCE_CHANNEL_ID=
DISCORD_SOURCE_CHANNEL_IDS=
DISCORD_SOURCE_GUILD_IDS=
DISCORD_SOURCE_BOT_ID=
DISCORD_SOURCE_BOT_IDS=
DISCORD_RESULT_PREFIX=
DISCORD_ACCEPT_BOT_MESSAGES=true
DISCORD_ACCEPT_HUMAN_MESSAGES=false
TIERS_CORS_ORIGINS=
